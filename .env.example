# Plant Arena - Configuración de Supabase
# Obtén estas claves en tu panel de Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# El dominio de verdad del juego.
#
# Es el que llevan los enlaces que el juego reparte: el de invitación
# (/?ref=CÓDIGO) y el de una repetición compartida (/r/CÓDIGO). Sin esta
# variable, esos enlaces se construyen con la dirección por la que estés
# navegando — y entonces desde Vercel salen apuntando a Vercel, y desde el
# ordenador de desarrollo apuntando a localhost.
#
# Sin barra al final.
VITE_PUBLIC_URL=https://www.plants-arena.online
